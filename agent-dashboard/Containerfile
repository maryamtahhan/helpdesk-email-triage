FROM registry.access.redhat.com/ubi9/python-312:latest

WORKDIR /app

COPY agent-dashboard/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agent-dashboard/app.py .
COPY agent-dashboard/.streamlit ./.streamlit
COPY scripts/openshift_route_host.py ./scripts/openshift_route_host.py
COPY --chmod=755 agent-dashboard/entrypoint.sh ./entrypoint.sh

EXPOSE 8501

ENTRYPOINT ["./entrypoint.sh"]
