# Hugging Face token — required only for the Red Hat AI Inference (RHAII) path
HF_TOKEN=

# Model served by the CPU inference engine
MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# Host cache for downloaded model weights
RHEL_CACHE_DIR=~/rhaii-cache

# FILE_WATCHER processes ./sample_emails; SMTP also listens on port 3025
GATEWAY_MODE=FILE_WATCHER

# OpenAI-compatible endpoint (base URL is /v1; chat completions also accepted)
VLLM_BASE_URL=http://rhaii-cpu-engine:8000/v1
VLLM_ENDPOINT=http://rhaii-cpu-engine:8000/v1/chat/completions

# Vault authentication — required by the email gateway and dashboard.
# The gateway rejects /vault requests without the correct X-Vault-Secret header.
# Change this before any real deployment; the value below is for the demo only.
VAULT_SECRET=helpdesk-demo-secret

# Streamlit UI origin for CORS (keep default for local / container deployments)
DASHBOARD_ORIGIN=http://localhost:8501

# Optional downstream delivery after each ticket is triaged (comma-separated).
#   log                         — log the public TriageResult JSON
#   webhook:https://host/hook   — POST JSON (set TICKET_SINK_SECRET for HMAC)
# Example: TICKET_SINK=webhook:https://case-mgmt.example.com/triage
TICKET_SINK=
TICKET_SINK_SECRET=

# Published images (default in compose files; override for forks or local tags)
# GATEWAY_IMAGE=quay.io/mayamtahhan/helpdesk-email-gateway:latest
# UI_IMAGE=quay.io/mayamtahhan/helpdesk-triage-ui:latest
# MOCK_IMAGE=quay.io/mayamtahhan/helpdesk-inference-mock:latest
