# Podman Quadlet container unit — place in ~/.config/containers/systemd/
#
# Build the image first:
#   podman build -t localhost/helpdesk-triage-ui:prod ./agent-dashboard
#
# Enable:
#   systemctl --user daemon-reload
#   systemctl --user enable --now agent-dashboard.service

[Unit]
Description=Helpdesk Triage Agent Dashboard
After=email-gateway.service
Requires=email-gateway.service

[Container]
Image=localhost/helpdesk-triage-ui:prod
ContainerName=rhaii-triage-ui
PublishPort=8501:8501
Environment=GATEWAY_URL=http://rhaii-email-gateway:8080
Environment=SMTP_HOST=rhaii-email-gateway
EnvironmentFile=%h/.config/helpdesk/secrets.env
Volume=%h/helpdesk/docs:/app/docs:ro
Network=helpdesk.network

[Install]
WantedBy=default.target
