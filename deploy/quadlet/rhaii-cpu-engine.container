# Podman Quadlet container unit — place in ~/.config/containers/systemd/
#
# Prerequisites:
#   podman login registry.redhat.io
#   mkdir -p ~/rhaii-cache
#   echo "HF_TOKEN=hf_..." > ~/.config/helpdesk/secrets.env
#
# Enable:
#   systemctl --user daemon-reload
#   systemctl --user enable --now rhaii-cpu-engine.service

[Unit]
Description=Red Hat AI Inference 3.5 CPU Engine
After=network-online.target
Wants=network-online.target

[Container]
Image=registry.redhat.io/rhaii/vllm-cpu-rhel9:3.5.0-1786546771
ContainerName=rhaii-cpu-engine
PublishPort=8000:8000
Environment=VLLM_CPU_KVCACHE_SPACE=8
Environment=HF_HUB_OFFLINE=0
Environment=LD_PRELOAD=/usr/lib64/libomp.so
EnvironmentFile=%h/.config/helpdesk/secrets.env
Volume=%h/rhaii-cache:/opt/app-root/src/.cache:Z
Network=helpdesk.network
Exec=--model Qwen/Qwen2.5-1.5B-Instruct --host 0.0.0.0 --port 8000
UserNS=keep-id:uid=1001
ShmSize=4g
SecurityLabelDisable=true
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/v1/models', timeout=3)"
HealthInterval=15s
HealthRetries=40
HealthStartPeriod=180s

[Service]
Restart=on-failure
RestartSec=15
TimeoutStartSec=600

[Install]
WantedBy=default.target
