FROM registry.access.redhat.com/ubi9/python-312:latest

WORKDIR /app

COPY email-gateway/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY email-gateway/app ./app
COPY email-gateway/gateways ./gateways
COPY email-gateway/vllm-email-gw.json ./vllm-email-gw.json
COPY scripts/openshift_route_host.py ./scripts/openshift_route_host.py
COPY email-gateway/entrypoint.sh ./entrypoint.sh
RUN chmod +x entrypoint.sh

EXPOSE 8080 3025

ENTRYPOINT ["./entrypoint.sh"]
